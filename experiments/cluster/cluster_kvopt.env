# kvopt gather-scheme benchmark — REAL CLUSTER config (air-gapped; results
# typed back as summaries). Topology follows suites/vslm_eval/config/cluster.env:
# EPYC initiator (local) + BlueField-3 DPU target over TCP (the RoCE/RDMA data
# fabric is not usable on this cluster; TCP via the reachable interface works).
#
# Namespace is fully DISJOINT from the vslm/cpcs work:
#   repos      /home/<user>/kvopt/spdk      (cpcs_paper/spdk is read-only seed)
#   listener   10.1.10.37:4430              (4420 stays with vslm-eval)
#   NQN        nqn.2026-07.io.spdk:kvopt-bench
#   RPC sock   /var/tmp/kvopt_tgt.sock

PROVENANCE="${PROVENANCE:-real_cluster}"

# DEFAULT SETUP comes from the cluster inventory
#   cpcs_paper/experiments/cpcs/inventories/real_cluster.yaml
# (the cpcs_paper submodule; override the file with INVENTORY=...).
# Hosts, SSH, seed repo paths, fabric address, target core mask and rep
# count are all taken from it. Explicit env always wins; hardcoded
# fallbacks (matching the 2026-07 inventory) cover a checkout without the
# submodule. Only the benchmark IDENTITY stays kvopt-specific so runs
# never collide with vslm-eval: port 4430, kvopt NQN, own RPC socket.
_kvopt_here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
INVENTORY="${INVENTORY:-$_kvopt_here/../../cpcs_paper/experiments/cpcs/inventories/real_cluster.yaml}"
if [ -f "$INVENTORY" ]; then
	eval "$(python3 - "$INVENTORY" <<'PYEOF'
import re, sys

out = {}
try:
    import yaml
    inv = yaml.safe_load(open(sys.argv[1]))

    def g(*ks):
        v = inv
        for k in ks:
            if not isinstance(v, dict) or k not in v:
                return None
            v = v[k]
        return v

    out = {
        "_INV_DPU_USER": g("hosts", "target", "ssh_user"),
        "_INV_DPU_HOST": g("hosts", "target", "ssh_host"),
        "_INV_DPU_PORT": g("hosts", "target", "ssh_port"),
        "_INV_INIT_REPO": g("hosts", "initiator", "repo_path"),
        "_INV_TGT_REPO": g("hosts", "target", "repo_path"),
        "_INV_TRADDR": g("nvmeof", "traddr"),
        "_INV_TRTYPE": g("nvmeof", "trtype"),
        "_INV_TGT_CORE_MASK": g("runtime", "target_core_mask"),
        "_INV_REPS": g("runtime", "measured_reps"),
    }
except ImportError:
    # line-based fallback for the auto-generated inventory layout
    txt = open(sys.argv[1]).read()

    def section(name):
        m = re.search(rf"^{name}:\n((?:[ \t]+.*\n?)*)", txt, re.M)
        return m.group(1) if m else ""

    def kv(block, key):
        m = re.search(rf"^\s+{key}:\s*\"?([^\"\n#]+?)\"?\s*$", block, re.M)
        return m.group(1).strip() if m else None

    hosts = section("hosts")
    ini, _, tgt = hosts.partition("target:")
    nv, rt = section("nvmeof"), section("runtime")
    out = {
        "_INV_DPU_USER": kv(tgt, "ssh_user"),
        "_INV_DPU_HOST": kv(tgt, "ssh_host"),
        "_INV_DPU_PORT": kv(tgt, "ssh_port"),
        "_INV_INIT_REPO": kv(ini, "repo_path"),
        "_INV_TGT_REPO": kv(tgt, "repo_path"),
        "_INV_TRADDR": kv(nv, "traddr"),
        "_INV_TRTYPE": kv(nv, "trtype"),
        "_INV_TGT_CORE_MASK": kv(rt, "target_core_mask"),
        "_INV_REPS": kv(rt, "measured_reps"),
    }

for k, v in out.items():
    if v is not None:
        print(f'{k}="{v}"')
PYEOF
)"
fi

# --- hosts (inventory: hosts.target / hosts.initiator) ---
DPU_SSH="${DPU_SSH:-${_INV_DPU_USER:-ubuntu}@${_INV_DPU_HOST:-10.1.10.37}}"
DPU_SSH_PORT="${DPU_SSH_PORT:-${_INV_DPU_PORT:-22}}"
INIT_REPO="${INIT_REPO:-$HOME/kvopt/spdk}"
DPU_REPO="${DPU_REPO:-/home/ubuntu/kvopt/spdk}"
# read-only seeds for git history + submodule sources (never written to):
# the inventory's repo_path entries
INIT_SEED_REPO="${INIT_SEED_REPO:-${_INV_INIT_REPO:-/home/kyuho/cpcs_paper/spdk}}"
DPU_SEED_REPO="${DPU_SEED_REPO:-${_INV_TGT_REPO:-/home/ubuntu/cpcs_paper/spdk}}"

# --- NVMe-oF fabric (inventory: nvmeof.trtype/traddr) ---
TRTYPE="${TRTYPE:-${_INV_TRTYPE:-TCP}}"
TRADDR="${TRADDR:-${_INV_TRADDR:-10.1.10.37}}"
# kvopt-specific identity (do NOT inherit: port 4420 / the vslm NQN belong
# to vslm-eval)
TRSVCID="${TRSVCID:-4430}"
NQN="${NQN:-nqn.2026-07.io.spdk:kvopt-bench}"

# --- target (DPU; inventory: runtime.target_core_mask) ---
RPC_SOCK="${RPC_SOCK:-/var/tmp/kvopt_tgt.sock}"
TGT_CORE_MASK="${TGT_CORE_MASK:-${_INV_TGT_CORE_MASK:-0xFFFF}}"
TGT_MEM_MB="${TGT_MEM_MB:-2048}"          # hugepage cap so co-resident SPDK work keeps its pool

# --- initiator bench app ---
APP_ARGS="${APP_ARGS:--m 0x2 -H -s 1024}" # single-threaded app, hugepage-free

# --- workload / measurement discipline (inventory: runtime.measured_reps) ---
SUITE="${SUITE:-quick}"                   # quick: verify+baseline; full: +chunk & QD sweeps
REPS="${REPS:-${_INV_REPS:-5}}"           # baseline reps (median reported)
TIME_SEC="${TIME_SEC:-10}"
WARMUP_SEC="${WARMUP_SEC:-2}"
RESULT_ROOT="${RESULT_ROOT:-$HOME/kvopt_results}"
