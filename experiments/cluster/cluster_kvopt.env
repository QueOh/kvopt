# kvopt gather-scheme benchmark — REAL CLUSTER config (air-gapped; results
# typed back as summaries). Topology follows suites/vslm_eval/config/cluster.env:
# EPYC initiator (local) + BlueField-3 DPU target over TCP (the RoCE/RDMA data
# fabric is not usable on this cluster; TCP via the reachable interface works).
#
# Namespace is fully DISJOINT from the vslm/cpcs work:
#   repos      /home/<user>/kvopt/spdk      (cpcs_paper/spdk is read-only seed)
#   listener   10.1.10.37:4430              (4420 stays with vslm-eval)
#   NQN        nqn.2026-07.io.spdk:kvopt-bench
#   RPC sock   /var/tmp/kvopt_tgt.sock

PROVENANCE="${PROVENANCE:-real_cluster}"

# Inherit fabric/seed facts from the cpcs_paper inventory when the submodule
# is checked out (kvopt repo layout: this file lives at experiments/cluster/,
# the submodule at <repo>/cpcs_paper). Explicit env still wins; hardcoded
# fallbacks below match the inventory as of 2026-07.
_kvopt_here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
_paper_env="$_kvopt_here/../../cpcs_paper/experiments/cpcs/suites/vslm_eval/config/cluster.env"
if [ -f "$_paper_env" ]; then
	eval "$(bash -c "source '$_paper_env' > /dev/null 2>&1
		echo _PAPER_TRADDR=\$TRADDR
		echo _PAPER_SPDK_REPO=\$SPDK_REPO")"
fi

# --- hosts ---
DPU_SSH="${DPU_SSH:-ubuntu@10.1.10.37}"
INIT_REPO="${INIT_REPO:-$HOME/kvopt/spdk}"
DPU_REPO="${DPU_REPO:-/home/ubuntu/kvopt/spdk}"
# read-only seeds for git history + submodule sources (never written to)
INIT_SEED_REPO="${INIT_SEED_REPO:-${_PAPER_SPDK_REPO:-/home/kyuho/cpcs_paper/spdk}}"
DPU_SEED_REPO="${DPU_SEED_REPO:-/home/ubuntu/cpcs_paper/spdk}"

# --- NVMe-oF fabric (TCP; see the paper cluster.env for why not RDMA) ---
TRADDR="${TRADDR:-${_PAPER_TRADDR:-10.1.10.37}}"
TRSVCID="${TRSVCID:-4430}"
NQN="${NQN:-nqn.2026-07.io.spdk:kvopt-bench}"

# --- target (DPU) ---
RPC_SOCK="${RPC_SOCK:-/var/tmp/kvopt_tgt.sock}"
TGT_CORE_MASK="${TGT_CORE_MASK:-0xF}"     # 4 DPU cores; vslm-eval uses 0xFFFF when it runs
TGT_MEM_MB="${TGT_MEM_MB:-2048}"          # hugepage cap so co-resident SPDK work keeps its pool

# --- initiator bench app ---
APP_ARGS="${APP_ARGS:--m 0x2 -H -s 1024}" # single-threaded app, hugepage-free

# --- workload / measurement discipline ---
SUITE="${SUITE:-quick}"                   # quick: verify+baseline; full: +chunk & QD sweeps
REPS="${REPS:-5}"                         # baseline reps (median reported), matches vslm >=5
TIME_SEC="${TIME_SEC:-10}"
WARMUP_SEC="${WARMUP_SEC:-2}"
RESULT_ROOT="${RESULT_ROOT:-$HOME/kvopt_results}"
